{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sewsure.invalid/schemas/lesson.schema.json",
  "title": "SewSure technique micro-lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["lesson_id", "version", "status", "title", "summary", "skippable", "used_by_recipes", "steps", "practice", "reviewed_by", "reviewed_on"],
  "properties": {
    "lesson_id": {"type": "string", "pattern": "^lesson_[a-z0-9_]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "reviewed", "retired"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "skippable": {"const": true},
    "suggested_for_beginners": {"type": "boolean"},
    "used_by_recipes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "items": {
        "type": "object", "required": ["id", "text"],
        "properties": {"id": {"type": "string"}, "text": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "practice": {
      "type": "object", "required": ["task", "materials", "done_when"],
      "properties": {
        "task": {"type": "string", "minLength": 1},
        "materials": {"type": "string"},
        "done_when": {"type": "string"}
      },
      "additionalProperties": false
    },
    "progress_note": {"type": "string"},
    "reviewed_by": {"type": ["string", "null"]},
    "reviewed_on": {"type": ["string", "null"]}
  }
}
