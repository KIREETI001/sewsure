{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiySteps",
  "description": "Reviewed recipe content for one PASS_SUPPORTED_CHECKS revision (blueprint §8). A recipe without reviewed instructions is never returned as an executable guide.",
  "type": "object",
  "required": ["revision_id", "recipe_id", "recipe_version", "review", "required_tools", "skill_prerequisites", "materials", "steps", "extra_tools_or_skills_required"],
  "properties": {
    "revision_id": { "$ref": "common.schema.json#/$defs/Id" },
    "recipe_id": { "$ref": "common.schema.json#/$defs/RecipeId" },
    "recipe_version": { "$ref": "common.schema.json#/$defs/Version" },
    "review": {
      "type": "object",
      "required": ["reviewed_on", "reviewer_role"],
      "properties": {
        "reviewed_on": { "type": "string", "format": "date" },
        "reviewer_role": { "type": "string", "enum": ["experienced_sewist", "supervisor", "instructor"] }
      },
      "additionalProperties": false
    },
    "required_tools": { "$ref": "inspiration.schema.json#/$defs/Tools" },
    "skill_prerequisites": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Slug" } },
    "materials": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Step" } },
    "practice_exercises": { "type": "array", "items": { "$ref": "#/$defs/Step" } },
    "extra_tools_or_skills_required": {
      "type": "boolean",
      "description": "true when the recipe needs tools or skills the user did not state; the app then offers the tailor route."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Step": {
      "type": "object",
      "required": ["step_id", "order", "phase", "title", "body", "irreversible"],
      "properties": {
        "step_id": { "$ref": "common.schema.json#/$defs/Slug" },
        "order": { "type": "integer", "minimum": 1 },
        "phase": { "type": "string", "enum": ["prepare", "measure", "mark", "ruler_checkpoint", "cut", "finish", "verify", "practice"] },
        "title": { "type": "string", "maxLength": 80 },
        "body": { "type": "string", "maxLength": 1200 },
        "irreversible": { "type": "boolean", "description": "Cutting and similar actions. Must be preceded by a ruler_checkpoint step." },
        "checkpoint_id": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/Slug" }, { "type": "null" }],
          "description": "CutPlan ruler checkpoint verified in this step."
        },
        "media_refs": { "type": "array", "items": { "type": "string", "maxLength": 200 } }
      },
      "additionalProperties": false
    }
  }
}
