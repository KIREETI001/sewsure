{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quote",
  "description": "A tailor's response to a MakerRequest: a price quote, a clarification request, or an infeasibility flag. Tailor role only.",
  "type": "object",
  "required": ["quote_id", "request_id", "tailor_id", "kind", "message", "created_at"],
  "properties": {
    "quote_id": { "$ref": "common.schema.json#/$defs/Id" },
    "request_id": { "$ref": "common.schema.json#/$defs/Id" },
    "tailor_id": { "$ref": "common.schema.json#/$defs/Id" },
    "kind": { "type": "string", "enum": ["quote", "clarification_request", "infeasible"] },
    "price": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Money" }, { "type": "null" }] },
    "estimated_duration_days": { "type": ["integer", "null"], "minimum": 0, "maximum": 365 },
    "message": { "type": "string", "maxLength": 1000 },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "quote" } } },
      "then": { "required": ["price"], "properties": { "price": { "$ref": "common.schema.json#/$defs/Money" } } }
    }
  ],
  "$defs": {
    "QuoteCreate": {
      "type": "object",
      "required": ["kind", "message"],
      "properties": {
        "kind": { "type": "string", "enum": ["quote", "clarification_request", "infeasible"] },
        "price": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Money" }, { "type": "null" }] },
        "estimated_duration_days": { "type": ["integer", "null"], "minimum": 0, "maximum": 365 },
        "message": { "type": "string", "maxLength": 1000 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "quote" } } },
          "then": { "required": ["price"], "properties": { "price": { "$ref": "common.schema.json#/$defs/Money" } } }
        }
      ]
    }
  }
}
