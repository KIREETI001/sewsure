{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CutPlan",
  "description": "Dimensioned cut guide for exactly one PASS_SUPPORTED_CHECKS revision. Coordinates are mm in the garment frame (§5.1). A calibrated photo overlay is allowed only when calibration.state is calibrated; otherwise the app shows the dimensioned diagram. The user verifies every ruler checkpoint before cutting.",
  "type": "object",
  "required": ["cut_plan_id", "revision_id", "recipe_id", "recipe_version", "units", "mode", "coordinate_frame", "pieces", "allowances", "ruler_checkpoints", "calibration", "provenance", "created_at"],
  "properties": {
    "cut_plan_id": { "$ref": "common.schema.json#/$defs/Id" },
    "revision_id": { "$ref": "common.schema.json#/$defs/Id" },
    "recipe_id": { "$ref": "common.schema.json#/$defs/RecipeId" },
    "recipe_version": { "$ref": "common.schema.json#/$defs/Version" },
    "units": { "$ref": "common.schema.json#/$defs/Units" },
    "mode": {
      "type": "string",
      "enum": ["calibrated_overlay", "dimensioned_diagram"]
    },
    "coordinate_frame": {
      "type": "object",
      "required": ["origin_landmark", "x_axis", "y_axis"],
      "properties": {
        "origin_landmark": { "$ref": "common.schema.json#/$defs/Slug", "examples": ["centre_back_neck"] },
        "x_axis": { "type": "string", "maxLength": 100, "examples": ["towards wearer's left, along shoulder line"] },
        "y_axis": { "type": "string", "maxLength": 100, "examples": ["downwards, towards hem"] }
      },
      "additionalProperties": false
    },
    "pieces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/FabricPiece" }
    },
    "allowances": {
      "type": "object",
      "required": ["seam_allowance_mm", "hem_allowance_mm"],
      "properties": {
        "seam_allowance_mm": { "$ref": "common.schema.json#/$defs/LengthMm" },
        "hem_allowance_mm": { "$ref": "common.schema.json#/$defs/LengthMm" }
      },
      "additionalProperties": false
    },
    "ruler_checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/RulerCheckpoint" }
    },
    "calibration": { "$ref": "#/$defs/Calibration" },
    "provenance": { "$ref": "common.schema.json#/$defs/Provenance" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "calibrated_overlay" } } },
      "then": { "properties": { "calibration": { "properties": { "state": { "const": "calibrated" } } } } }
    }
  ],
  "$defs": {
    "PointMm": {
      "type": "array",
      "description": "[x_mm, y_mm] in the cut plan's coordinate frame.",
      "prefixItems": [
        { "$ref": "common.schema.json#/$defs/SignedLengthMm" },
        { "$ref": "common.schema.json#/$defs/SignedLengthMm" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "Line": {
      "type": "object",
      "required": ["line_id", "kind", "points_mm", "label"],
      "properties": {
        "line_id": { "$ref": "common.schema.json#/$defs/Slug" },
        "kind": { "type": "string", "enum": ["cut", "stitch", "fold", "reference"] },
        "points_mm": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/PointMm" } },
        "label": { "type": "string", "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "FabricPiece": {
      "type": "object",
      "required": ["piece_id", "source_panel", "lines"],
      "properties": {
        "piece_id": { "$ref": "common.schema.json#/$defs/Slug" },
        "source_panel": {
          "$ref": "common.schema.json#/$defs/Slug",
          "examples": ["back_panel", "front_left", "front_right", "sleeve_left", "sleeve_right"]
        },
        "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Line" } },
        "prohibited_regions": {
          "type": "array",
          "description": "Seams, plackets, armholes or decorations the cut must not cross.",
          "items": { "$ref": "common.schema.json#/$defs/Slug" }
        }
      },
      "additionalProperties": false
    },
    "RulerCheckpoint": {
      "type": "object",
      "required": ["checkpoint_id", "instruction", "from_landmark", "distance_mm", "tolerance_mm"],
      "properties": {
        "checkpoint_id": { "$ref": "common.schema.json#/$defs/Slug" },
        "instruction": { "type": "string", "maxLength": 300 },
        "from_landmark": { "$ref": "common.schema.json#/$defs/Slug" },
        "distance_mm": { "$ref": "common.schema.json#/$defs/LengthMm" },
        "tolerance_mm": { "$ref": "common.schema.json#/$defs/LengthMm" }
      },
      "additionalProperties": false
    },
    "Calibration": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["none", "uncalibrated", "calibrated", "rejected"],
          "description": "calibrated = scale (and perspective, if supported) fitted with error within the team-agreed tolerance."
        },
        "calibration_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Id" }, { "type": "null" }] },
        "reference_photo_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Id" }, { "type": "null" }] },
        "scale_px_per_mm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "median_error_mm": { "oneOf": [{ "$ref": "common.schema.json#/$defs/LengthMm" }, { "type": "null" }] },
        "max_error_mm": { "oneOf": [{ "$ref": "common.schema.json#/$defs/LengthMm" }, { "type": "null" }] },
        "tolerance_mm": { "oneOf": [{ "$ref": "common.schema.json#/$defs/LengthMm" }, { "type": "null" }] },
        "rejection_reason": { "type": ["string", "null"], "maxLength": 200 }
      },
      "additionalProperties": false
    }
  }
}
