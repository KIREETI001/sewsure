{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job",
  "description": "Async generation job (POST /v1/projects/{id}/generate). Poll GET /v1/jobs/{job_id}. A complete job may still have zero designs.",
  "type": "object",
  "required": ["job_id", "kind", "project_id", "state", "created_at", "updated_at"],
  "properties": {
    "job_id": { "$ref": "common.schema.json#/$defs/Id" },
    "kind": { "type": "string", "enum": ["generate_designs"] },
    "project_id": { "$ref": "common.schema.json#/$defs/Id" },
    "state": { "type": "string", "enum": ["queued", "running", "complete", "failed"] },
    "stage": {
      "type": ["string", "null"],
      "enum": ["A_garment", "B_inspiration", "C_load_inputs", "D_propose", "E_check", "F_refine_rank", "G_preview", "H_save", null],
      "description": "Pipeline stage (§4.2) while running. For progress display only."
    },
    "result": {
      "oneOf": [{ "$ref": "#/$defs/JobResult" }, { "type": "null" }]
    },
    "error": {
      "oneOf": [{ "$ref": "api-error.schema.json" }, { "type": "null" }]
    },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "complete" } } },
      "then": { "required": ["result"], "properties": { "result": { "$ref": "#/$defs/JobResult" }, "error": { "type": "null" } } }
    },
    {
      "if": { "properties": { "state": { "const": "failed" } } },
      "then": { "required": ["error"], "properties": { "error": { "$ref": "api-error.schema.json" }, "result": { "type": "null" } } }
    }
  ],
  "$defs": {
    "JobResult": {
      "type": "object",
      "required": ["design_ids"],
      "properties": {
        "design_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Id" },
          "minItems": 0,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "GenerateRequest": {
      "type": "object",
      "description": "Body of POST /v1/projects/{project_id}/generate. Retries with the same Idempotency-Key header return the original job.",
      "required": ["inspiration"],
      "properties": {
        "inspiration": { "$ref": "inspiration.schema.json#/$defs/InspirationInput" }
      },
      "additionalProperties": false
    }
  }
}
